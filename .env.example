# Optional only. Required for live Base Sepolia commands, not for tests.
# Do not commit private keys, funded wallet secrets, or RPC credentials.
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_DEPLOYER_ADDRESS=
BASE_SEPOLIA_POOL_MANAGER=0x05E73354cFDd6745C338b50BcFDfA3Aa6fA03408
BASE_SEPOLIA_SOURCE_VERIFICATION_STATUS=not_submitted

# Optional reader inputs. These are for public evidence reads, not deployment.
FLOWMEMORY_RPC_URL=
FLOWMEMORY_HOOK_ADDRESS=
FLOWMEMORY_FROM_BLOCK=
FLOWMEMORY_TO_BLOCK=latest
FLOWMEMORY_FINALITY_CONFIRMATIONS=20
FLOWMEMORY_LATEST_BLOCK=

# Optional PulseWatch state/output paths for the always-on reader loop.
FLOWMEMORY_PULSEWATCH_STATE=.flowmemory/pulsewatch-state.json
FLOWMEMORY_PULSEWATCH_MEMORY_STORE=.flowmemory/pulsewatch-memory.jsonl
